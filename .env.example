# Port configuration for the Express server (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB Community Server: mongodb://localhost:27017/imovies
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/imovies?retryWrites=true&w=majority
# Note: If omitted, the app will run with the resilient in-memory database store with zero external setup.
MONGODB_URI=mongodb://localhost:27017/imovies

# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=imovies_super_secret_jwt_key_2025_academic_btech

# Client Origin URL for CORS configuration
CLIENT_URL=http://localhost:3000

# Base URL for frontend API communication (Vite client convention)
VITE_API_BASE_URL=/api

# Google Gemini API Key (if optional AI features are enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio App URL
APP_URL="MY_APP_URL"
